{
  "name": "daily-reminder",
  "private": true,
  "version": "0.2.0",
  "description": "Morries Reminder AI desktop planner",
  "author": "Morries",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && set ELECTRON_RUN_AS_NODE=&& electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "electron:build": "npm run build && electron-builder --win nsis --x64",
    "lint": "eslint .",
    "portable": "powershell -ExecutionPolicy Bypass -File scripts/make-portable.ps1",
    "preview": "vite preview",
    "release:portable": "npm run build && npm run portable",
    "release:web": "npm run build && node scripts/prepare-public-release.mjs"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.4",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "wait-on": "^8.0.5",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.dailyreminder.app",
    "productName": "Morries Reminder",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "src/utils/**",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "oneClick": false,
      "perMachine": false
    }
  }
}
